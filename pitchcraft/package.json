{
  "name": "pitchcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pitchcraft \u2014 an original browser-based 3D football match simulator built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node tools/headlessMatch.js",
    "diagnose": "node tools/diagnose.js",
    "audit": "node tools/audit.js",
    "audit:bot": "node tools/audit.js 5 --bot",
    "shots": "node tools/capture.js",
    "closeup": "node tools/closeup.js",
    "hero": "node tools/hero.js",
    "interact": "node tools/interact.js",
    "leakcheck": "node tools/leakcheck.js",
    "mobile": "node tools/mobile.js",
    "single": "vite build && node tools/singlefile.js"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "playwright": "^1.48.0"
  },
  "engines": {
    "node": ">=18"
  }
}
